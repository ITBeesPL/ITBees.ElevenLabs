<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ITBees.ElevenLabs</PackageId>
    <Version>8.0.1</Version>
    <Authors>ITBees</Authors>
    <Description>Connector to the ElevenLabs API: text to speech returning an audio file ready to be saved, the voices of the account and the subscription usage. The API key comes from the platform settings (ElevenLabsApiKey) or from a host-provided key provider.</Description>
    <PackageTags>elevenlabs;tts;text-to-speech;voice;audio;itbees</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ITBeesPL/ITBees.ElevenLabs</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ITBees.Interfaces" Version="8.0.72" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

</Project>
